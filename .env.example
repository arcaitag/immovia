# =============================================================================
# Immovia – Umgebungsvariablen
# Kopieren nach .env.local (lokal) bzw. in Vercel unter Project → Settings →
# Environment Variables eintragen. Niemals echte Werte committen.
# =============================================================================

# --- Öffentliche Basis-URL (ohne Schrägstrich am Ende) -----------------------
# Lokal: http://localhost:3000 · Produktion: https://www.immovia.ch
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Pflicht) -----------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
# Publishable Key (sb_publishable_…) oder Legacy anon key – darf öffentlich sein
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret Key (sb_secret_…) oder Legacy service_role key – NUR serverseitig!
# Wird für Bewertungen, KI-Jobs, E-Mail-Versand, Aufrufstatistik und Cron benötigt.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- KI (optional, ohne Schlüssel sind KI-Funktionen als «nicht verfügbar» markiert)
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modell für Texte, Erklärungen und Assistent (Standard siehe src/lib/ai/config.ts)
ANTHROPIC_MODEL=
# Optionaler Bild-KI-Anbieter für Perspektivkorrektur und virtuelle Möblierung.
# Noch nicht angebunden – siehe docs/ARCHITEKTUR.md, Abschnitt 5.
IMAGE_AI_PROVIDER=
# Optionaler lizenzierter Bewertungsanbieter (AVM) – noch nicht angebunden.
# Erst setzen, wenn ein Vertrag und ein Adapter in src/lib/valuation/providers/ bestehen.
VALUATION_AVM_PROVIDER=

# --- E-Mail (optional, ohne Schlüssel werden E-Mails in der Outbox gehalten) --
# https://resend.com → API Keys; Absenderdomain muss in Resend verifiziert sein
RESEND_API_KEY=
EMAIL_FROM="Immovia <noreply@immovia.ch>"
EMAIL_REPLY_TO=support@immovia.ch

# --- Betrieb ----------------------------------------------------------------
# Schützt /api/cron/*; Vercel sendet ihn automatisch als Bearer Token
CRON_SECRET=
# Zufälliger Wert (mind. 32 Zeichen) für die gehashte Besucherkennung der Statistik
ANALYTICS_SALT=

# --- Tests (nur lokal) -------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres@localhost:54329/immovia_test
E2E_BASE_URL=http://localhost:3000
